# ClearFlow Environment Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# If PostgreSQL server is running locally or remotely, specify DATABASE_URL.
# If left as is or unreachable, the system seamlessly initializes embedded PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clearflow

# Authentication
JWT_SECRET=clearflow_super_secure_jwt_secret_2026_fintech_production_key
JWT_EXPIRES_IN=7d

# Optional External AI API Key (Leave empty to use the built-in deterministic recovery reasoning engine)
AI_API_KEY=
